#!/bin/sh
# BlockcheckW Zapret2 Integration Helper for OpenWrt
# Bridges blockcheckw scanner with OpenWrt LuCI and Zapret2 configuration.

STATUS_FILE="/tmp/blockcheckw_status.json"
PID_FILE="/var/run/blockcheckw.pid"
LOG_FILE="/tmp/blockcheckw_run.log"
OUTPUT_VANILLA="/tmp/blockcheckw_vanilla.txt"
OUTPUT_SCAN="/tmp/blockcheckw_scan.json"
OUTPUT_CIRCULAR="/tmp/blockcheckw_circular.txt"
TURBO_FILE="/tmp/blockcheckw_turbo.txt"
PRESETS_FILE="/usr/share/blockcheckw/zapret2_presets.json"
CIRCULAR_BUILDER="/usr/bin/circular-builder.lua"

VERSION_FILE="/usr/share/blockcheckw/version.json"
REPO_RAW="https://raw.githubusercontent.com/prostoy23rus/blockcheckw/main"

ensure_json() {
    [ -f "$STATUS_FILE" ] || echo '{"status":"idle","percent":0,"phase":"Ожидание запуска","strategies":[],"log":""}' > "$STATUS_FILE"
}

write_status() {
    local status="$1"
    local percent="$2"
    local phase="$3"
    local extra="$4"
    
    local log_tail=""
    if [ -f "$LOG_FILE" ]; then
        log_tail=$(tail -n 40 "$LOG_FILE" | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
    fi

    local circular_esc=""
    if [ -f "$OUTPUT_CIRCULAR" ]; then
        circular_esc=$(sed 's/"/\\"/g' "$OUTPUT_CIRCULAR" | awk '{printf "%s\\n", $0}')
    fi

    local isp=""
    local block_type=""
    if [ -f "$LOG_FILE" ]; then
        isp=$(grep -i "ISP:" "$LOG_FILE" 2>/dev/null | head -n 1 | sed 's/.*ISP:[[:space:]]*//' | sed 's/"/\\"/g' | tr -d '\r\n')
    fi
    if [ -f "$OUTPUT_SCAN" ]; then
        block_type=$(lua -e '
            local json = require("luci.jsonc")
            local f = io.open("'"$OUTPUT_SCAN"'", "r")
            if f then
                local d = json.parse(f:read("*a"))
                f:close()
                if d and d.block_type then print(d.block_type) end
            end
        ' 2>/dev/null | tr -d '\r\n')
    fi
    if [ -z "$block_type" ] && [ -f "$LOG_FILE" ]; then
        if grep -qi "SNI blocked" "$LOG_FILE"; then
            block_type="sni_blocked"
        elif grep -qi "IP blocked" "$LOG_FILE"; then
            block_type="ip_blocked"
        elif grep -qi "BLOCKED" "$LOG_FILE"; then
            block_type="sni_blocked"
        fi
    fi

    cat <<EOF > "$STATUS_FILE"
{
  "status": "$status",
  "percent": $percent,
  "phase": "$phase",
  "log": "$log_tail",
  "circular": "$circular_esc",
  "isp": "$isp",
  "block_type": "$block_type"
  $extra
}
EOF
}

get_preset_param() {
    local preset="$1"
    local param="$2"
    lua -e '
        local json = require("luci.jsonc")
        local f = io.open("'"$PRESETS_FILE"'", "r")
        if not f then print("") return end
        local d = json.parse(f:read("*a"))
        f:close()
        if d and d.presets and d.presets["'"$preset"'"] then
            local val = d.presets["'"$preset"'"]["'"$param"'"]
            if type(val) == "table" then
                print(table.concat(val, ","))
            else
                print(tostring(val or ""))
            end
        else
            print("")
        end
    ' 2>/dev/null
}

prepare_turbo_corpus() {
    local preset="$1"
    lua -e '
        local json = require("luci.jsonc")
        local f = io.open("'"$PRESETS_FILE"'", "r")
        if not f then os.exit(1) end
        local d = json.parse(f:read("*a"))
        f:close()
        local strats = d and d.presets and d.presets["'"$preset"'"] and d.presets["'"$preset"'"].turbo_strategies
        if not strats or #strats == 0 then
            strats = d and d.presets and d.presets["builtin"] and d.presets["builtin"].turbo_strategies
        end
        if strats and #strats > 0 then
            local out = io.open("'"$TURBO_FILE"'", "w")
            for _, s in ipairs(strats) do
                out:write(s .. "\n")
            end
            out:close()
        else
            os.exit(1)
        end
    ' 2>/dev/null
}

cmd_start() {
    local target="youtube"
    local domain=""
    local mode="turbo"
    local do_circular="1"
    local auto_apply="0"
    local workers="2"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --domain) domain="$2"; shift 2 ;;
            --mode) mode="$2"; shift 2 ;;
            --circular) do_circular="$2"; shift 2 ;;
            --auto-apply) auto_apply="$2"; shift 2 ;;
            --workers) workers="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    # Check if already running
    if [ -f "$PID_FILE" ]; then
        local old_pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            echo '{"error":"Scanner is already running","pid":'"$old_pid"'}'
            return 1
        fi
    fi

    # Resolve target and domain
    local protocols="tls12,tls13"
    case "$target" in
        preset_youtube|youtube)
            domain=$(get_preset_param "preset_youtube" "domain")
            [ -n "$domain" ] || domain="googlevideo.com"
            protocols="tls12,tls13"
            ;;
        preset_discord|discord)
            domain=$(get_preset_param "preset_discord" "domain")
            [ -n "$domain" ] || domain="gateway.discord.gg"
            protocols="tls12,tls13"
            ;;
        preset_twitch|twitch)
            domain=$(get_preset_param "preset_twitch" "domain")
            [ -n "$domain" ] || domain="twitch.tv"
            protocols="tls12,tls13"
            ;;
        preset_x|x)
            domain=$(get_preset_param "preset_x" "domain")
            [ -n "$domain" ] || domain="x.com"
            protocols="tls12,tls13"
            ;;
        preset_instagram|instagram)
            domain=$(get_preset_param "preset_instagram" "domain")
            [ -n "$domain" ] || domain="gateway.instagram.com"
            protocols="tls12,tls13"
            ;;
        tcp16)
            domain=$(get_preset_param "tcp16" "domain")
            [ -n "$domain" ] || domain="media.miele.com"
            protocols="tls12,tls13"
            ;;
        builtin|general)
            domain=$(get_preset_param "builtin" "domain")
            [ -n "$domain" ] || domain="rutracker.org"
            protocols="http,tls12,tls13"
            ;;
        domains|custom)
            [ -n "$domain" ] || domain="rutracker.org"
            protocols="http,tls12,tls13"
            ;;
        test_strategy)
            [ -n "$domain" ] || domain="rutracker.org"
            protocols="http,tls12,tls13"
            ;;
        *)
            [ -n "$domain" ] || domain="rutracker.org"
            protocols="http,tls12,tls13"
            ;;
    esac

    rm -f "$OUTPUT_VANILLA" "$OUTPUT_SCAN" "$OUTPUT_CIRCULAR" "$TURBO_FILE" "$LOG_FILE"
    echo "" > "$LOG_FILE"

    write_status "running" 10 "Инициализация сканирования ($domain)"

    # Run in background via child process detached from rpcd pipes
    (
        local scan_args="-d $domain -p $protocols --dns doh --auto"
        if [ "$mode" = "turbo" ]; then
            prepare_turbo_corpus "$target"
            if [ -f "$TURBO_FILE" ] && [ -s "$TURBO_FILE" ]; then
                scan_args="$scan_args --from-file $TURBO_FILE"
            fi
        fi

        echo "[blockcheckw-helper] Starting scan for $domain (target=$target, mode=$mode, workers=$workers, auto_apply=$auto_apply)..." >> "$LOG_FILE"
        write_status "running" 25 "Тестирование обхода DPI..."

        /usr/bin/blockcheckw -w "$workers" scan $scan_args -o "$OUTPUT_SCAN" >> "$LOG_FILE" 2>&1

        # Locate latest scan report in /root if needed
        local latest_vanilla=$(ls -t /root/*_report_vanilla.txt 2>/dev/null | head -n 1)
        if [ -n "$latest_vanilla" ] && [ -f "$latest_vanilla" ]; then
            cp -f "$latest_vanilla" "$OUTPUT_VANILLA"
        fi
        local latest_scan=$(ls -t /root/*_scan.json 2>/dev/null | head -n 1)
        if [ -n "$latest_scan" ] && [ -f "$latest_scan" ]; then
            cp -f "$latest_scan" "$OUTPUT_SCAN"
        fi

        # Check for found strategies
        local found_count=0
        if [ -f "$OUTPUT_SCAN" ]; then
            found_count=$(lua -e '
                local json = require("luci.jsonc")
                local f = io.open("'"$OUTPUT_SCAN"'", "r")
                if f then
                    local d = json.parse(f:read("*a"))
                    f:close()
                    if d and d.strategies then print(#d.strategies) else print(0) end
                else print(0) end
            ' 2>/dev/null)
        fi

        # Build circular strategy if requested
        if [ "$do_circular" = "1" ] && [ "$found_count" -gt 0 ]; then
            write_status "running" 85 "Сборка отказоустойчивой Circular-стратегии..."
            lua "$CIRCULAR_BUILDER" "$OUTPUT_SCAN" 3 20 4 loop > "$OUTPUT_CIRCULAR" 2>> "$LOG_FILE"
        fi

        # Extract strategy list for JSON output
        local strats_json="[]"
        local top_strategy=""
        if [ -f "$OUTPUT_SCAN" ]; then
            strats_json=$(lua -e '
                local json = require("luci.jsonc")
                local f = io.open("'"$OUTPUT_SCAN"'", "r")
                if f then
                    local d = json.parse(f:read("*a"))
                    f:close()
                    if d and d.strategies then
                        local list = {}
                        for _, s in ipairs(d.strategies) do
                            table.insert(list, s.args or s)
                        end
                        print(json.stringify(list))
                    else print("[]") end
                else print("[]") end
            ' 2>/dev/null)
            
            top_strategy=$(lua -e '
                local json = require("luci.jsonc")
                local f = io.open("'"$OUTPUT_SCAN"'", "r")
                if f then
                    local d = json.parse(f:read("*a"))
                    f:close()
                    if d and d.strategies and d.strategies[1] then
                        print(d.strategies[1].args or d.strategies[1])
                    end
                end
            ' 2>/dev/null)
        fi

        local apply_info=""
        # Auto-apply if requested and strategies found
        if [ "$auto_apply" = "1" ] && [ "$found_count" -gt 0 ]; then
            write_status "running" 95 "Автоматическое применение стратегии в Zapret2..."
            local apply_res=""
            if [ "$do_circular" = "1" ] && [ -f "$OUTPUT_CIRCULAR" ] && [ -s "$OUTPUT_CIRCULAR" ]; then
                apply_res=$(cmd_apply --target "$target" --file "$OUTPUT_CIRCULAR")
            elif [ -n "$top_strategy" ]; then
                echo "$top_strategy" > /tmp/blockcheckw_top_strat.txt
                apply_res=$(cmd_apply --target "$target" --file /tmp/blockcheckw_top_strat.txt)
            fi

            if [ -n "$apply_res" ]; then
                echo "[blockcheckw-helper] Auto-applied strategy to $target: $apply_res" >> "$LOG_FILE"
                apply_info=",\"auto_applied\":true,\"apply_result\":$apply_res"
            fi
        fi

        rm -f "$PID_FILE"

        local dns_err=$(grep -E 'DNS resolve failed|no IPv4 addresses found' "$LOG_FILE" 2>/dev/null | tail -n 1)
        if [ -n "$dns_err" ]; then
            write_status "error" 0 "Ошибка DNS: $dns_err" ",\"strategies\":[]"
            echo "[blockcheckw-helper] Scan failed with DNS error: $dns_err" >> "$LOG_FILE"
        elif [ "$found_count" -gt 0 ]; then
            local final_msg="Найдено рабочих стратегий: $found_count"
            [ "$auto_apply" = "1" ] && final_msg="$final_msg (Успешно применена в Zapret2!)"
            write_status "done" 100 "$final_msg" ",\"strategies\":$strats_json$apply_info"
            echo "[blockcheckw-helper] Finished successfully. Found $found_count working strategies." >> "$LOG_FILE"
        else
            write_status "done" 100 "Поиск завершен. Ничего не подошло, попробуйте глубокий скан." ",\"strategies\":[]"
            echo "[blockcheckw-helper] Scan completed with 0 matches." >> "$LOG_FILE"
        fi
    ) </dev/null >/dev/null 2>&1 &

    local pid=$!
    echo "$pid" > "$PID_FILE"
    echo '{"status":"started","pid":'"$pid"',"domain":"'"$domain"'","mode":"'"$mode"'","auto_apply":'"$auto_apply"'}'
}

cmd_status() {
    ensure_json
    local running=false
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            running=true
        else
            rm -f "$PID_FILE"
        fi
    fi

    lua - "$STATUS_FILE" "$LOG_FILE" "$OUTPUT_SCAN" << 'EOF'
local json = require("luci.jsonc")
local status_file = arg[1]
local log_file = arg[2]
local scan_file = arg[3]

local st = {}
local sf = io.open(status_file, "r")
if sf then
    st = json.parse(sf:read("*a")) or {}
    sf:close()
end

-- Enrich with ISP from log if missing
if not st.isp or st.isp == "" then
    local lf = io.open(log_file, "r")
    if lf then
        for line in lf:lines() do
            local isp_match = line:match("ISP:%s*(.+)")
            if isp_match then
                st.isp = isp_match:gsub("[\r\n]", ""):gsub("^%s+", "")
                break
            end
        end
        lf:close()
    end
end

-- Enrich with block_type from scan or log if missing
if not st.block_type or st.block_type == "" then
    local scf = io.open(scan_file, "r")
    if scf then
        local sc = json.parse(scf:read("*a")) or {}
        scf:close()
        if sc.block_type then
            st.block_type = sc.block_type
        end
    end
end

if not st.block_type or st.block_type == "" then
    local lf = io.open(log_file, "r")
    if lf then
        local content = lf:read("*a") or ""
        lf:close()
        local bt = content:match('"block_type":%s*"([^"]+)"')
        if bt then
            st.block_type = bt
        elseif content:find("SNI blocked") or content:find("BLOCKED") then
            st.block_type = "sni_blocked"
        elseif content:find("IP blocked") then
            st.block_type = "ip_blocked"
        end
    end
end

print(json.stringify(st))
EOF
}

cmd_stop() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ]; then
            kill -TERM "$pid" 2>/dev/null
            sleep 1
            kill -9 "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
    fi
    killall -9 blockcheckw 2>/dev/null
    nft delete table inet blockcheckw 2>/dev/null
    /etc/init.d/zapret2 restart >/dev/null 2>&1
    write_status "idle" 0 "Остановлено пользователем"
    echo '{"status":"stopped"}'
}

cmd_apply() {
    local target=""
    local script_text=""
    local script_file=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --script) script_text="$2"; shift 2 ;;
            --file) script_file="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [ -n "$script_file" ] && [ -f "$script_file" ]; then
        script_text=$(cat "$script_file")
    fi

    if [ -z "$target" ] || [ -z "$script_text" ]; then
        echo '{"success":false,"error":"Missing --target or --script argument"}'
        return 1
    fi

    # Backup zapret2 config
    local ts=$(date +%Y%m%d_%H%M%S)
    cp -f /etc/config/zapret2 "/etc/config/zapret2.bak.$ts"

    # Map target to base strategy section
    local base_sec=""
    local port="443"
    local l7="tls"
    local hostlist=""
    local test_url=""

    case "$target" in
        preset_youtube|youtube)
            base_sec="MyTube"
            port="443"
            l7="tls"
            hostlist="list_hosts_youtube"
            test_url="https://googlevideo.com"
            ;;
        preset_discord|discord)
            base_sec="BlockcheckW_Discord"
            port="443"
            l7="tls discord"
            hostlist="list_hosts_discord"
            test_url="https://gateway.discord.gg"
            ;;
        preset_twitch|twitch)
            base_sec="BlockcheckW_Twitch"
            port="443"
            l7="tls"
            hostlist="list_hosts_user"
            test_url="https://twitch.tv"
            ;;
        preset_x|x)
            base_sec="BlockcheckW_X"
            port="443"
            l7="tls"
            hostlist="list_hosts_user"
            test_url="https://x.com"
            ;;
        preset_instagram|instagram)
            base_sec="BlockcheckW_Instagram"
            port="443"
            l7="tls"
            hostlist="list_hosts_user"
            test_url="https://gateway.instagram.com"
            ;;
        tcp16)
            base_sec="BlockcheckW_TCP16"
            port="443"
            l7="tls"
            hostlist="list_hosts_user"
            test_url="https://media.miele.com"
            ;;
        builtin|general)
            base_sec="BlockcheckW_General"
            port="80,443"
            l7="tls http"
            hostlist="list_hosts_user"
            test_url="https://rutracker.org"
            ;;
        *)
            local safe_t=$(echo "$target" | tr -c 'a-zA-Z0-9_' '_')
            base_sec="BlockcheckW_$safe_t"
            port="443"
            l7="tls"
            hostlist="list_hosts_user"
            test_url="https://$target"
            ;;
    esac

    # Determine unique new section name without overwriting existing strategies
    local sec_name=""
    if ! uci -q get "zapret2.$base_sec" >/dev/null; then
        sec_name="$base_sec"
    else
        local idx=2
        while uci -q get "zapret2.${base_sec}_$idx" >/dev/null; do
            idx=$((idx + 1))
        done
        sec_name="${base_sec}_$idx"
    fi

    # Disable previously active strategies for this target to prevent desync/filter conflicts,
    # keeping all older strategies safely stored in /etc/config/zapret2
    uci -q set "zapret2.$base_sec.enabled=0"
    local s
    for s in $(uci show zapret2 2>/dev/null | grep -E '^zapret2\.'"$base_sec"'_' | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
        uci -q set "zapret2.$s.enabled=0"
    done
    if [ "$base_sec" = "MyTube" ]; then
        uci -q set "zapret2.Youtube_circular.enabled=0"
    elif [ "$base_sec" = "BlockcheckW_Discord" ]; then
        uci -q set "zapret2.Discord_circular.enabled=0"
    elif [ "$base_sec" = "BlockcheckW_General" ]; then
        uci -q set "zapret2.Routerich_circular.enabled=0"
    fi

    # Create new strategy section in zapret2
    uci set "zapret2.$sec_name=strategy"
    uci set "zapret2.$sec_name.enabled=1"
    uci set "zapret2.$sec_name.port=$port"
    uci set "zapret2.$sec_name.protocol=tcp"
    uci add_list "zapret2.$sec_name.filter_l3=ipv4"
    for proto in $l7; do
        uci add_list "zapret2.$sec_name.filter_l7=$proto"
    done
    uci add_list "zapret2.$sec_name.hostlist=$hostlist"
    if [ "$target" = "preset_youtube" ] || [ "$target" = "youtube" ] || [ "$target" = "builtin" ] || [ "$target" = "general" ]; then
        uci add_list "zapret2.$sec_name.hostlist_exclude=list_hosts_user_exclude"
    fi
    uci set "zapret2.$sec_name.script=$script_text"

    uci commit zapret2

    # Restart zapret2 service
    /etc/init.d/zapret2 restart >/dev/null 2>&1
    sleep 1
    local zapret_running=$(/etc/init.d/zapret2 status 2>/dev/null)

    # Test connectivity with curl
    local curl_status=0
    local http_code=0
    if [ -n "$test_url" ]; then
        http_code=$(curl -k -s -o /dev/null -w "%{http_code}" --connect-timeout 5 "$test_url" 2>/dev/null)
        [ "$http_code" -gt 0 ] && curl_status=1
    fi

    cat <<EOF
{
  "success": true,
  "message": "Новая запись стратегии ($sec_name) успешно создана в Zapret2, активирована и проверена!",
  "target": "$target",
  "section": "$sec_name",
  "zapret2_status": "$zapret_running",
  "test_url": "$test_url",
  "http_code": "$http_code",
  "connected": $([ "$curl_status" = "1" ] && echo "true" || echo "false")
}
EOF
}

cmd_activate() {
    local target=""
    local section=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --section) section="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [ -z "$section" ]; then
        echo '{"success":false,"error":"Missing --section argument"}'
        return 1
    fi

    if ! uci -q get "zapret2.$section" >/dev/null; then
        echo "{\"success\":false,\"error\":\"Strategy section '$section' not found in zapret2\"}"
        return 1
    fi

    local base_sec=""
    case "$target" in
        preset_youtube|youtube) base_sec="MyTube" ;;
        preset_discord|discord) base_sec="BlockcheckW_Discord" ;;
        preset_twitch|twitch) base_sec="BlockcheckW_Twitch" ;;
        preset_x|x) base_sec="BlockcheckW_X" ;;
        preset_instagram|instagram) base_sec="BlockcheckW_Instagram" ;;
        tcp16) base_sec="BlockcheckW_TCP16" ;;
        builtin|general) base_sec="BlockcheckW_General" ;;
        *)
            if [ -n "$target" ]; then
                base_sec="BlockcheckW_$(echo "$target" | tr -c 'a-zA-Z0-9_' '_')"
            else
                base_sec=$(echo "$section" | sed -E 's/_[0-9]+$//')
            fi
            ;;
    esac

    # Disable all other sections for this target
    if [ -n "$base_sec" ]; then
        uci -q set "zapret2.$base_sec.enabled=0"
        local s
        for s in $(uci show zapret2 2>/dev/null | grep -E '^zapret2\.'"$base_sec"'_' | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
            uci -q set "zapret2.$s.enabled=0"
        done
        [ "$base_sec" = "MyTube" ] && uci -q set "zapret2.Youtube_circular.enabled=0"
        [ "$base_sec" = "BlockcheckW_Discord" ] && uci -q set "zapret2.Discord_circular.enabled=0"
        [ "$base_sec" = "BlockcheckW_General" ] && uci -q set "zapret2.Routerich_circular.enabled=0"
    fi

    # Enable target section
    uci set "zapret2.$section.enabled=1"
    uci commit zapret2

    /etc/init.d/zapret2 restart >/dev/null 2>&1
    sleep 1
    local zapret_running=$(/etc/init.d/zapret2 status 2>/dev/null)

    echo "{\"success\":true,\"message\":\"Стратегия $section успешно активирована в Zapret2!\",\"section\":\"$section\",\"zapret2_status\":\"$zapret_running\"}"
}

cmd_delete_strategy() {
    local section="$1"
    if [ -z "$section" ]; then
        echo '{"success":false,"error":"Missing section name"}'
        return 1
    fi
    uci -q delete "zapret2.$section"
    uci commit zapret2
    /etc/init.d/zapret2 restart >/dev/null 2>&1
    echo "{\"success\":true,\"message\":\"Запись $section удалена.\"}"
}

cmd_test() {
    local url="${1:-https://rutracker.org}"
    local code=$(curl -k -s -o /dev/null -w "%{http_code}" --connect-timeout 4 "$url" 2>/dev/null)
    local ok=false
    [ "$code" -gt 0 ] && ok=true
    echo '{"url":"'"$url"'","http_code":"'"$code"'","accessible":'"$ok"'}'
}

cmd_info() {
    local zapret_running=$(/etc/init.d/zapret2 status 2>/dev/null)

    lua -e '
        local uci = require("uci").cursor()
        local json = require("luci.jsonc")

        local res = {
            zapret2_running = "'"$zapret_running"'",
            services = {}
        }

        local all_strats = {}
        uci:foreach("zapret2", "strategy", function(s)
            local name = s[".name"]
            if name then
                table.insert(all_strats, {
                    section = name,
                    enabled = (s.enabled == "1" or s.enabled == 1),
                    port = s.port or "443",
                    script = s.script or "",
                    is_circular = (s.script and s.script:find("circular") ~= nil) or false
                })
            end
        end)
        res.all_strategies = all_strats

        local targets = {
            builtin = { base = "BlockcheckW_General", fallback = "Routerich_circular", name = "Встроенные хосты (33)" },
            general = { base = "BlockcheckW_General", fallback = "Routerich_circular", name = "Встроенные хосты (33)" },
            preset_youtube = { base = "MyTube", fallback = "Youtube_circular", name = "Предустановленный список YouTube (3)" },
            youtube = { base = "MyTube", fallback = "Youtube_circular", name = "YouTube" },
            preset_discord = { base = "BlockcheckW_Discord", fallback = "Discord_circular", name = "Предустановленный список Discord (3)" },
            discord = { base = "BlockcheckW_Discord", fallback = "Discord_circular", name = "Discord" },
            preset_twitch = { base = "BlockcheckW_Twitch", fallback = "BlockcheckW_General", name = "Предустановленный список Twitch (3)" },
            twitch = { base = "BlockcheckW_Twitch", fallback = "BlockcheckW_General", name = "Twitch" },
            preset_x = { base = "BlockcheckW_X", fallback = "BlockcheckW_General", name = "Предустановленный список X (3)" },
            x = { base = "BlockcheckW_X", fallback = "BlockcheckW_General", name = "X (Twitter)" },
            preset_instagram = { base = "BlockcheckW_Instagram", fallback = "BlockcheckW_General", name = "Предустановленный список Instagram (2)" },
            instagram = { base = "BlockcheckW_Instagram", fallback = "BlockcheckW_General", name = "Instagram" },
            tcp16 = { base = "BlockcheckW_TCP16", fallback = "BlockcheckW_General", name = "Кандидаты TCP 16-20 KB (110)" },
            domains = { base = "BlockcheckW_Custom", fallback = "BlockcheckW_General", name = "Свои домены" },
            custom = { base = "BlockcheckW_Custom", fallback = "BlockcheckW_General", name = "Свои домены" },
            test_strategy = { base = "BlockcheckW_General", name = "Тест стратегии" }
        }

        for key, info in pairs(targets) do
            local base = info.base
            local fallback = info.fallback

            local matching = {}
            for _, st in ipairs(all_strats) do
                if st.section == base or st.section:match("^" .. base .. "_%d+$") then
                    table.insert(matching, st)
                elseif fallback and st.section == fallback then
                    table.insert(matching, st)
                end
            end

            table.sort(matching, function(a, b)
                local num_a = tonumber(a.section:match("_(%d+)$")) or (a.section == base and 1 or 0)
                local num_b = tonumber(b.section:match("_(%d+)$")) or (b.section == base and 1 or 0)
                return num_a < num_b
            end)

            local active = nil
            for _, st in ipairs(matching) do
                if st.enabled then
                    active = st
                    break
                end
            end
            if not active and #matching > 0 then
                active = matching[#matching]
            end

            local vers = {}
            for _, m in ipairs(matching) do
                table.insert(vers, {
                    section = m.section,
                    enabled = m.enabled,
                    port = m.port,
                    is_circular = m.is_circular,
                    script = m.script
                })
            end

            if active then
                res.services[key] = {
                    section = active.section,
                    name = info.name,
                    enabled = active.enabled,
                    port = active.port,
                    script = active.script,
                    is_circular = active.is_circular,
                    versions_count = #vers,
                    versions = vers
                }
            else
                res.services[key] = {
                    section = base,
                    name = info.name,
                    enabled = false,
                    port = "443",
                    script = "",
                    is_circular = false,
                    versions_count = 0,
                    versions = {}
                }
            end
        end

        print(json.stringify(res))
    ' 2>/dev/null
}

cmd_logs() {
    local zapret_log=$(logread -e zapret2 2>/dev/null | tail -n 40 | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
    local scan_log=""
    if [ -f "$LOG_FILE" ]; then
        scan_log=$(tail -n 60 "$LOG_FILE" | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
    fi
    local daemons=$(ps -w | grep -E 'nfqws2|blockcheckw' | grep -v grep | head -n 10 | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')

    cat <<EOF
{
  "scanner_log": "$scan_log",
  "zapret2_log": "$zapret_log",
  "daemons": "$daemons"
}
EOF
}

cmd_check_update() {
    local cur_ver="0.15"
    if [ -f "$VERSION_FILE" ]; then
        cur_ver=$(lua -e 'local j = require("luci.jsonc"); local f = io.open("'"$VERSION_FILE"'", "r"); if f then local d = j.parse(f:read("*a")); f:close(); print(d and d.version or "0.15"); else print("0.15"); end' 2>/dev/null)
    fi

    local tmp_ver="/tmp/bcw_remote_ver.json"
    rm -f "$tmp_ver"
    curl -sSL -k --connect-timeout 5 "$REPO_RAW/openwrt/version.json" -o "$tmp_ver" 2>/dev/null

    if [ ! -s "$tmp_ver" ]; then
        echo "{\"success\":false,\"current_version\":\"$cur_ver\",\"error\":\"Не удалось связаться с GitHub\"}"
        return 1
    fi

    lua - "$cur_ver" "$tmp_ver" << 'EOF'
local json = require("luci.jsonc")
local cur_ver = arg[1] or "0.15"
local file = arg[2]

local f = io.open(file, "r")
if not f then
    print(string.format('{"success":false,"current_version":"%s","error":"Файл не найден"}', cur_ver))
    return
end

local content = f:read("*a")
f:close()

local rem = json.parse(content)
if type(rem) ~= "table" or not rem.version then
    print(string.format('{"success":false,"current_version":"%s","error":"Неверный ответ GitHub"}', cur_ver))
    return
end

local has_update = (rem.version ~= cur_ver)
local res = {
    success = true,
    current_version = cur_ver,
    latest_version = rem.version,
    has_update = has_update,
    changelog = rem.changelog or "",
    release_date = rem.release_date or "",
    repo = rem.repo or "prostoy23rus/blockcheckw"
}
print(json.stringify(res))
EOF
    rm -f "$tmp_ver"
}

cmd_update() {
    local tmp_dir="/tmp/bcw_update_$$"
    mkdir -p "$tmp_dir"

    echo "[blockcheckw-helper] Starting update from $REPO_RAW..." >> "$LOG_FILE"

    # Download updated files
    local ok=1
    curl -sSL -k --connect-timeout 8 "$REPO_RAW/openwrt/luci-app-blockcheckw/root/usr/bin/blockcheckw-helper" -o "$tmp_dir/blockcheckw-helper" || ok=0
    curl -sSL -k --connect-timeout 8 "$REPO_RAW/openwrt/luci-app-blockcheckw/root/usr/bin/circular-builder.lua" -o "$tmp_dir/circular-builder.lua" || ok=0
    curl -sSL -k --connect-timeout 8 "$REPO_RAW/openwrt/luci-app-blockcheckw/root/www/luci-static/resources/view/blockcheckw/main.js" -o "$tmp_dir/main.js" || ok=0
    curl -sSL -k --connect-timeout 8 "$REPO_RAW/strategies/zapret2_presets.json" -o "$tmp_dir/zapret2_presets.json" || ok=0
    curl -sSL -k --connect-timeout 8 "$REPO_RAW/openwrt/version.json" -o "$tmp_dir/version.json" || ok=0
    curl -sSL -k --connect-timeout 8 "$REPO_RAW/openwrt/luci-app-blockcheckw/root/usr/share/luci/menu.d/luci-app-blockcheckw.json" -o "$tmp_dir/menu.json" || ok=0
    curl -sSL -k --connect-timeout 8 "$REPO_RAW/openwrt/luci-app-blockcheckw/root/usr/share/rpcd/acl.d/luci-app-blockcheckw.json" -o "$tmp_dir/acl.json" || ok=0

    if [ "$ok" = "0" ] || [ ! -s "$tmp_dir/main.js" ] || [ ! -s "$tmp_dir/blockcheckw-helper" ]; then
        rm -rf "$tmp_dir"
        echo '{"success":false,"error":"Ошибка скачивания файлов обновления с GitHub"}'
        return 1
    fi

    mkdir -p /usr/bin /usr/share/blockcheckw /usr/share/luci/menu.d /usr/share/rpcd/acl.d /www/luci-static/resources/view/blockcheckw

    # Install files
    cp -f "$tmp_dir/blockcheckw-helper" /usr/bin/blockcheckw-helper
    cp -f "$tmp_dir/circular-builder.lua" /usr/bin/circular-builder.lua
    cp -f "$tmp_dir/main.js" /www/luci-static/resources/view/blockcheckw/main.js
    cp -f "$tmp_dir/zapret2_presets.json" /usr/share/blockcheckw/zapret2_presets.json
    cp -f "$tmp_dir/version.json" /usr/share/blockcheckw/version.json
    [ -s "$tmp_dir/menu.json" ] && cp -f "$tmp_dir/menu.json" /usr/share/luci/menu.d/luci-app-blockcheckw.json
    [ -s "$tmp_dir/acl.json" ] && cp -f "$tmp_dir/acl.json" /usr/share/rpcd/acl.d/luci-app-blockcheckw.json

    chmod +x /usr/bin/blockcheckw-helper /usr/bin/circular-builder.lua

    local new_ver="0.15"
    if [ -f "/usr/share/blockcheckw/version.json" ]; then
        new_ver=$(lua -e 'local j = require("luci.jsonc"); local f = io.open("/usr/share/blockcheckw/version.json", "r"); if f then local d = j.parse(f:read("*a")); f:close(); print(d and d.version or "0.15"); else print("0.15"); end' 2>/dev/null)
    fi

    # Clean caches and reload LuCI
    rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache*
    /etc/init.d/rpcd restart >/dev/null 2>&1
    rm -rf "$tmp_dir"

    echo "[blockcheckw-helper] Successfully updated to version $new_ver" >> "$LOG_FILE"
    echo '{"success":true,"version":"'"$new_ver"'","message":"Служба успешно обновлена до версии '"$new_ver"'!"}'
}

cmd_uninstall() {
    local remove_quic="$1"

    # Stop active scanning processes
    killall -9 blockcheckw 2>/dev/null || true

    # Prepare background cleanup runner
    cat << 'EOF' > /tmp/bcw_uninstall_exec.sh
#!/bin/sh
sleep 1
killall -9 blockcheckw-helper 2>/dev/null || true

rm -f /usr/bin/blockcheckw
rm -f /usr/bin/blockcheckw-helper
rm -f /usr/bin/circular-builder.lua
rm -rf /usr/share/blockcheckw
rm -f /usr/share/luci/menu.d/luci-app-blockcheckw.json
rm -f /usr/share/rpcd/acl.d/luci-app-blockcheckw.json
rm -rf /www/luci-static/resources/view/blockcheckw

rm -f /tmp/blockcheckw_*
rm -f /var/run/blockcheckw.pid
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache*

/etc/init.d/rpcd restart >/dev/null 2>&1 || true
/etc/init.d/uhttpd restart >/dev/null 2>&1 || true
ubus call luci reload >/dev/null 2>&1 || true

rm -f /tmp/bcw_uninstall_exec.sh
EOF
    chmod +x /tmp/bcw_uninstall_exec.sh

    if [ "$remove_quic" = "--remove-quic" ]; then
        if command -v uci >/dev/null 2>&1 && [ -f /etc/config/firewall ]; then
            uci delete firewall.reject_quic 2>/dev/null || true
            uci commit firewall 2>/dev/null || true
            /etc/init.d/firewall reload >/dev/null 2>&1 || true
        fi
    fi

    /tmp/bcw_uninstall_exec.sh </dev/null >/dev/null 2>&1 &

    echo '{"success":true,"message":"Служба BlockcheckW и веб-интерфейс LuCI успешно удалены с роутера"}'
}

case "$1" in
    start) shift; cmd_start "$@" ;;
    status) cmd_status ;;
    stop) cmd_stop ;;
    apply) shift; cmd_apply "$@" ;;
    activate) shift; cmd_activate "$@" ;;
    delete_strategy) shift; cmd_delete_strategy "$@" ;;
    test) shift; cmd_test "$@" ;;
    info) cmd_info ;;
    logs) shift; cmd_logs "$@" ;;
    check_update) cmd_check_update ;;
    update) cmd_update ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    *)
        echo "Usage: $0 {start|status|stop|apply|activate|delete_strategy|test|info|logs|check_update|update|uninstall}"
        exit 1
        ;;
esac
